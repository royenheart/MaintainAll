# addr2line2src $(addr2line -e xxx xxx)
# convert addr2line output to source code
function addr2line2src() {
    result=$1
    filename=$(echo $1 | cut -d':' -f1)
    line=$(echo $1 | cut -d':' -f2)
    sed -n "${line}p" "${filename}"
}

