function loop_cmd_until_success() {
    exe_cmd=$1
    max_loops=${2:-'5'}
    eval $exe_cmd
    for i in `seq 1 $max_loops`; do
        eval $exe_cmd
        if [[ $? == 0 ]]; then
            break
        fi
    done
}

