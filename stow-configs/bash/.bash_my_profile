# 移除通过 npx skills 安装的技能
# 用法: remove_skills <skill-name>   例: remove_skills dws
#       remove_skills superpowers   移除整个 superpowers 技能集 + OpenCode 插件
# 布局: ~/.claude/skills/<name> 为软链 -> ~/.agents/skills/<name> 为实体目录
function remove_skills() {
    local skill="$1"
    if [[ -z "$skill" ]]; then
        echo "用法: remove_skills <skill-name|superpowers>" >&2
        return 1
    fi

    local names=("$skill")
    if [[ "$skill" == "superpowers" ]]; then
        names=(brainstorming dispatching-parallel-agents executing-plans
               finishing-a-development-branch receiving-code-review requesting-code-review
               subagent-driven-development systematic-debugging test-driven-development
               using-git-worktrees using-superpowers verification-before-completion
               writing-plans writing-skills)
    fi

    local name target
    for name in "${names[@]}"; do
        echo "==> 移除 $name"
        npx skills remove -g -y "$name" || true   # 官方命令, 失败则走下面手动清理

        # 手动兜底: 软链用 rm -f, 实体目录用 rm -rf
        for target in \
            "$HOME/.claude/skills/$name" \
            "$HOME/.agents/skills/$name" \
            "$HOME/.config/opencode/skills/$name" \
            "$HOME/.codex/skills/$name"
        do
            if [[ -L "$target" ]]; then
                rm -f "$target"
                echo "  已移除软链: $target"
            elif [[ -d "$target" ]]; then
                rm -rf "$target"
                echo "  已移除目录: $target"
            fi
        done

        if [[ -e "$HOME/.claude/skills/$name" || -e "$HOME/.agents/skills/$name" ]]; then
            echo "  警告: $name 仍有残留, 请检查" >&2
        fi
    done

    # superpowers 还以 OpenCode 插件形式安装, 需要单独清理
    if [[ "$skill" == "superpowers" ]]; then
        # 配置可能是 opencode.json 或 opencode.jsonc (.json 优先, 与 opencode 加载优先级一致)
        local cfg=""
        for c in "$HOME/.config/opencode/opencode.json" "$HOME/.config/opencode/opencode.jsonc"; do
            if [[ -f "$c" ]]; then cfg="$c"; break; fi
        done
        if [[ -n "$cfg" ]] && grep -q 'superpowers' "$cfg"; then
            local backup="$cfg.bak.$(date +%Y%m%d_%H%M%S)"
            cp -f "$cfg" "$backup"
            echo "已备份: $cfg -> $backup"
            if [[ "$cfg" == *.json ]] && command -v python3 >/dev/null 2>&1; then
                # 严格 JSON: 从 plugin 数组移除 superpowers 项, 并校验/修复 (悬空逗号)
                python3 - "$cfg" <<'PY'
import json, sys
p = sys.argv[1]
try:
    with open(p) as f:
        cfg = json.load(f)
except Exception as e:
    print(f"警告: 无法解析 {p}: {e}, 请手动删除 superpowers 插件行", file=sys.stderr)
    sys.exit(1)
plugins = [x for x in cfg.get("plugin", []) if "superpowers" not in x]
if len(plugins) != len(cfg.get("plugin", [])):
    cfg["plugin"] = plugins
    with open(p, "w") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")
    print(f"已从 {p} 移除 superpowers 插件声明")
PY
            else
                # .jsonc 允许注释/尾随逗号: 按行删除, 保留其余内容与注释
                sed -i '/"superpowers@git+https:\/\/github.com\/obra\/superpowers.git",/d' "$cfg"
                echo "已从 ${cfg##*/} 移除 superpowers 插件声明(按行删除, 保留注释)"
            fi
        else
            echo "未找到含 superpowers 的 opencode 配置 ($HOME/.config/opencode/opencode.json 或 .jsonc)"
        fi
        rm -rf "$HOME/.cache/opencode/packages/superpowers@git+https:"
        echo "已清理 OpenCode 插件缓存: ~/.cache/opencode/packages/superpowers@git+https:"
    fi

    echo "done"
}

# === dsh 插件集 (apps/) 安装/卸载 ===
# dsh 插件放在 $MAINTAINALL_REPO/apps/ 下, 用 pnpm 的 link: 协议装进 profile 的
# node_modules, maintainall.yml 里按裸包名引用 (dsh 的正常加载方式)。
# 用法: install_dsh_plugins / uninstall_dsh_plugins
# 环境变量: MAINTAINALL_REPO (可选, 覆盖自动检测),
#           DSH_PROFILE (默认 web), DSH_HOME (默认 ~/.dsh)

# 预览/正式版兼容
if ! command -v dsh >/dev/null 2>&1; then
    # 如果不存在，则将其 alias 为 npx dsh
    alias dsh='npx @deepseek-ai/dsh'
fi 

# 用 python3 幂等地增删 cordis.patch.yml 里的 maintainall include 条目。
# 按行编辑(不经过 YAML 往返), 能保留 !!js 标签与注释。python3 不可用时返回非零。
function _manage_cordis_patch() {
    local action="$1"   # add | remove
    local file="$2"

    if ! command -v python3 >/dev/null 2>&1; then
        echo "错误: 未找到 python3" >&2
        return 1
    fi

    python3 "$_MAINTAINALL_REPO_ROOT/scripts/dsh_manage_cordis.py" "$action" "$file"
}

function install_dsh_plugins() {
    local repo="${MAINTAINALL_REPO:-$_MAINTAINALL_REPO_ROOT}"
    local profile="${DSH_PROFILE:-web}"
    local dsh_home="${DSH_HOME:-$HOME/.dsh}"
    local p

    if [[ ! -d "$repo/apps" ]]; then
        echo "错误: 找不到 $repo/apps" >&2
        echo "      请先 clone MaintainAll, 或用 MAINTAINALL_REPO 指定仓库路径" >&2
        return 1
    fi

    # 1. 构建每个 dsh 插件 (tsdown → lib/)
    for p in "$repo"/apps/dsh-plugin-*; do
        [[ -d "$p" && -f "$p/package.json" ]] || continue
        echo "==> build $(basename "$p")"
        (cd "$p" && npm install && npm run build) || return 1
    done

    # 2. 把每个插件 link 进 profile 的 node_modules
    for p in "$repo"/apps/dsh-plugin-*; do
        [[ -d "$p" && -f "$p/package.json" ]] || continue
        echo "==> link $(basename "$p")"
        dsh plugin --profile "$profile" add "link:$p" || return 1
    done

    # 3. stow 插件清单到 profile 目录 (maintainall.yml 必须和 cordis.yml 同目录,
    #    裸包名才能从 profile 的 node_modules 解析)
    (cd "$repo/stow-configs" && stow dsh -t "$dsh_home/profiles/$profile") || return 1

    # 4. 用 python 自动把 cordis:include 写进 profile 的 cordis.patch.yml
    local patch_file="$dsh_home/profiles/$profile/cordis.patch.yml"
    if ! _manage_cordis_patch add "$patch_file"; then
        echo "==> python3 不可用, 请手动在 $patch_file 里加下面这条:" >&2
        echo "    - insert:" >&2
        echo "        - id: maintainall" >&2
        echo "          name: cordis:include" >&2
        echo "          config:" >&2
        echo "            path: ./maintainall.yml" >&2
    fi

    echo
    echo "==> done。dsh $profile 重启即可。"
}

function uninstall_dsh_plugins() {
    local repo="${MAINTAINALL_REPO:-$_MAINTAINALL_REPO_ROOT}"
    local profile="${DSH_PROFILE:-web}"
    local dsh_home="${DSH_HOME:-$HOME/.dsh}"
    local p name

    for p in "$repo"/apps/dsh-plugin-*; do
        [[ -d "$p" && -f "$p/package.json" ]] || continue
        name="$(node -p "require('$p/package.json').name" 2>/dev/null)"
        [[ -n "$name" ]] || continue
        echo "==> remove $name"
        dsh plugin --profile "$profile" remove "$name" 2>/dev/null || true
    done

    (cd "$repo/stow-configs" && stow -D dsh -t "$dsh_home/profiles/$profile" 2>/dev/null || true)

    # 用 python 自动删掉 profile 的 cordis.patch.yml 里的 cordis:include 条目
    local patch_file="$dsh_home/profiles/$profile/cordis.patch.yml"
    if ! _manage_cordis_patch remove "$patch_file"; then
        echo "==> python3 不可用, 请手动从 $patch_file 删掉 id: maintainall 那条。" >&2
    fi
    echo "==> done。"
}

# =========== SET WSL VPN ===========
# Plz use wsl networking mode 'mirrored' if possible, this has greater support for VPN.
# SEE: https://learn.microsoft.com/zh-cn/windows/wsl/networking#mirrored-mode-networking

# Set WSL's proxy in NAT mode
# TESTED ON: v2raya

# Prepare:
# 1. WSL network mode in NAT
# 2. enable WSL localhost forwarding

# SEE: https://learn.microsoft.com/zh-cn/windows/wsl/wsl-config
# SEE ALSO: https://zhuanlan.zhihu.com/p/414627975
# WARNING: wsl cant use v2ray's nameserver, so it needs to be changed
# ABOUT v2raya: https://v2raya.org/docs/prologue/quick-start
# =========== SET WSL VPN ===========

function backup_file() {
    local file=$1
    if [[ -f "$file" ]]; then
        sudo cp -f "$file" "$file.bak"
        echo "已备份: $file -> $file.bak"
    fi
}

function set_proxy() {
    local hostip=${1-'192.168.0.1'}
    local hostport=${2-'20170'}
    local proxy_type=${3-'socks5'}
    export HTTPS_PROXY="${proxy_type}://${hostip}:${hostport}";
    export HTTP_PROXY="${proxy_type}://${hostip}:${hostport}";
    export ALL_PROXY="${proxy_type}://${hostip}:${hostport}";
    export no_proxy="localhost,127.0.0.1,192.168.1.0/24,.example.com"
}

function unset_proxy() {
    unset HTTPS_PROXY;
    unset HTTP_PROXY;
    unset ALL_PROXY;
}

function set_wsl_proxy() {
    # 1. 处理 /etc/wsl.conf
    WSL_CONF="/etc/wsl.conf"
    if [[ ! -f "$WSL_CONF" ]]; then
        # 文件不存在：创建并写入内容
        echo "创建 $WSL_CONF"
        backup_file "$WSL_CONF"  # 备份空文件（实际创建备份文件但不包含内容）
        sudo bash -c "echo -e '[network]\ngenerateResolvConf = false' > $WSL_CONF"
    else
        # 文件存在：进行修改
        backup_file "$WSL_CONF"

        # 检查 generateResolvConf 是否存在
        if grep -q "generateResolvConf" "$WSL_CONF"; then
            # 存在：替换为 true
            sudo sed -i 's/^generateResolvConf\s*=.*/generateResolvConf = false/' "$WSL_CONF"
            echo "已更新 generateResolvConf = false"
        else
            # 不存在：检查 [network] 是否存在
            if grep -q "^\[network\]" "$WSL_CONF"; then
                # [network] 存在：在其后插入
                sudo sed -i '/^\[network\]/a generateResolvConf = false' "$WSL_CONF"
                echo "已插入 generateResolvConf = false"
            else
                # [network] 不存在：在文件末尾追加
                sudo bash -c "echo -e '\n[network]\ngenerateResolvConf = false' >> $WSL_CONF"
                echo "已添加 [network] 和 generateResolvConf = false"
            fi
        fi
    fi

    # 2. 处理 /etc/resolv.conf
    RESOLV_CONF="/etc/resolv.conf"
    backup_file "$RESOLV_CONF"  # 无论是否存在都尝试备份

    # 检查 nameserver 是否存在
    if grep -q "^nameserver" "$RESOLV_CONF"; then
        # 存在：替换为 8.8.8.8
        sudo sed -i 's/^nameserver\s.*/nameserver 8.8.8.8/' "$RESOLV_CONF"
        echo "已将 nameserver 替换为 8.8.8.8"
    else
        # 不存在：在文件末尾追加
        sudo bash -c "echo 'nameserver 8.8.8.8' >> $RESOLV_CONF"
        echo "已添加 nameserver 8.8.8.8"
    fi

    echo "所有操作完成！备份文件已创建(.bak)"
    local hostip=$(ip route | grep default | awk '{print $3}')

    # v2raya default:
    # 1. socks5: 20170
    # 2. http: 20171
    # 3. https: 20172

    local hostport=${1-'20170'}
    local proxy_type=${2-'socks5'}
    export HTTPS_PROXY="${proxy_type}://${hostip}:${hostport}";
    export HTTP_PROXY="${proxy_type}://${hostip}:${hostport}";
    export ALL_PROXY="${proxy_type}://${hostip}:${hostport}";
    echo -e "Acquire::http::Proxy \"http://${hostip}:${hostport}\";" | sudo tee -a /etc/apt/apt.conf.d/proxy.conf > /dev/null;
    echo -e "Acquire::https::Proxy \"http://${hostip}:${hostport}\";" | sudo tee -a /etc/apt/apt.conf.d/proxy.conf > /dev/null;
} 

function unset_wsl_proxy() {
    # return wsl.conf and set auto generate resolve.conf
    WSL_CONF="/etc/wsl.conf"
    sudo mv -f ${WSL_CONF}.bak $WSL_CONF
    unset HTTPS_PROXY;
    unset HTTP_PROXY;
    unset ALL_PROXY;
    sudo sed -i -e '/Acquire::http::Proxy/d' /etc/apt/apt.conf.d/proxy.conf;
    sudo sed -i -e '/Acquire::https::Proxy/d' /etc/apt/apt.conf.d/proxy.conf;
}

