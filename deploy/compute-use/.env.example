# ============================================================
# Remote Computer Use — environment
# ============================================================
# Copy to .env, or let `./deploy.py setup-env` generate it.

# --- Authentication ---
# Shared secret between the relay and the client control plane.
CLIENT_TOKEN=

# --- Client Control Plane (the machine being controlled) ---
# HTTPS endpoint of the client's control plane. It listens on :9111.
CUACTL_ENDPOINT=https://REPLACE-ME:9111
CUACTL_TOKEN=${CLIENT_TOKEN}

# --- Relay container ---
CUACTL_CONTAINER=cuactl
# Docker network the relay joins. Other stacks can attach to it with
# `external: true` to gain desktop access.
CUA_NETWORK=cua-net

# --- Optional ---
TZ=Asia/Shanghai
