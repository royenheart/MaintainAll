# Hermes Agent — Headless mode configuration for CUA deployment
#
# This file is a bind-mounted template. deploy.py overwrites it inside the
# container at runtime via _configure_hermes_env(), filling in the correct
# model.provider / model.default / model.base_url from PROVIDER_REGISTRY.
# The values below are fallbacks used only if deploy.py hasn't run yet.
#
# In headless mode, Hermes Agent does not run its own gateway.
# It receives messages from AstrBot via the Hermes Hub (port 8420).
# Computer Use operations go through cuactl to the Client Control Plane.
# API keys live in ~/.hermes/.env (written by deploy.py).

model:
  default: ""
  provider: "auto"
  base_url: ""

tools:
  computer_use:
    enabled: true
    cli_path: "/usr/local/bin/cuactl"
    endpoint: "${CUACTL_ENDPOINT}"
    token: "${CUACTL_TOKEN}"
  terminal:
    enabled: false
  browser:
    enabled: false
  web_search:
    enabled: true

agent:
  max_iterations: 30
  tool_timeout_seconds: 120
  system_prompt_append: |
    You have access to a remote Windows desktop via the `computer_use` tool.
    Use the `cuactl` CLI commands to control it:

    - `cuactl capture` — take a screenshot
    - `cuactl click X Y` — click at coordinates
    - `cuactl type "text"` — type text
    - `cuactl press_key KEY` — press a key
    - `cuactl list-apps` — list running applications
    - `cuactl open-app "AppName"` — open/activate an application
    - `cuactl app-info "AppName"` — get application details
    - `cuactl app-position "AppName"` — get window position

    Before clicking, always take a screenshot first to understand the current state.
    Use deterministic operations (list-apps, app-info, open-app) when possible
    to avoid unnecessary screenshot+click cycles.

server:
  enabled: true
  host: "0.0.0.0"
  port: 8420

gateway:
  enabled: false
