# ============================================================
# Remote Computer Use — Environment Variables
# ============================================================
# Generated by deploy.py setup-env

# --- Authentication Tokens (auto-generated by deploy.py) ---
CLIENT_TOKEN=
BRIDGE_AUTH_TOKEN=

# --- Client Connection ---
# Public address of your Windows PC running the Client Control Plane
CUACTL_ENDPOINT=https://your-client-ip:9111
CUACTL_TOKEN=${CLIENT_TOKEN}

# --- LLM Provider ---
# Hermes Agent needs an LLM key to process messages.
# Supported: Anthropic, OpenAI, OpenRouter, Google Gemini, DeepSeek,
#            xAI Grok, Qwen, Ollama, LM Studio, Bedrock, and 25+ more.
# Docs: https://github.com/NousResearch/hermes-agent
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- AstrBot ---
ASTRBOT_DASHBOARD_PASSWORD=
