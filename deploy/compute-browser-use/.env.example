# ============================================================
# Remote Computer Use — Environment Variables
# ============================================================

# --- Authentication Tokens (set via deploy.py or manually) ---
HERMES_ACCESS_TOKEN=
CLIENT_TOKEN=

# --- Client Connection (set via deploy.py or manually) ---
CUACTL_ENDPOINT=
CUACTL_TOKEN=${CLIENT_TOKEN}

# --- LLM Provider (set via deploy.py or manually) ---
# Hermes Agent + AstrBot both use these credentials.
# Supported providers: deepseek, openai, anthropic, gemini, openrouter, ollama, ...
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- AstrBot LLM Provider (auto-set by setup-env, or fill manually) ---
# Type: openai_chat_completion | anthropic_chat_completion
# Model: deepseek-v4-flash | gpt-4o | claude-sonnet-4-20250514 | ...
ASTRBOT_PROVIDER_ID=
ASTRBOT_PROVIDER_TYPE=
ASTRBOT_PROVIDER_MODEL=

# --- Bridge fallback (uncomment to enable hermes_forward + hermes-bridge) ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.bridge.yml

# --- AstrBot ---
ASTRBOT_DASHBOARD_PASSWORD=
