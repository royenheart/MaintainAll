# ============================================================
# Remote Computer Use — Environment Variables
# ============================================================

# --- Authentication Tokens (set via deploy.py or manually) ---
HERMES_ACCESS_TOKEN=
CLIENT_TOKEN=

# --- Client Connection (set via deploy.py or manually) ---
CUACTL_ENDPOINT=
CUACTL_TOKEN=${CLIENT_TOKEN}

# --- LLM Provider (set via deploy.py or manually) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- AstrBot ---
# Initial dashboard password (first run only; subsequent
# redeploys reuse the password stored in astrbot_data volume).
ASTRBOT_DASHBOARD_PASSWORD=
