# ============================================================
# AstrBot — minimal deployment environment
# ============================================================
# Copy to .env, or let `./deploy.py setup-env` generate it.

# --- Required ---
# Dashboard password. Only applied the first time AstrBot
# initialises its data volume; afterwards it lives in the volume.
# Must be >=8 chars and contain upper case, lower case and a digit.
ASTRBOT_DASHBOARD_PASSWORD=

# --- Optional: image / update control ---
# Pin a tag for reproducible updates (recommended for anything you
# depend on). `latest` tracks upstream and updates on every pull.
ASTRBOT_TAG=latest

# --- Optional: naming ---
ASTRBOT_CONTAINER=astrbot
ASTRBOT_PORT=6185
# Compose volume name. Set this to an existing volume to adopt prior
# data instead of starting from an empty one, e.g.
#   ASTRBOT_VOLUME=compute-browser-use_astrbot_data
ASTRBOT_VOLUME=astrbot_data

# --- Optional: misc ---
TZ=Asia/Shanghai
