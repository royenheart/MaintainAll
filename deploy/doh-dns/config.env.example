# Copy to config.env and adjust before install (optional).
# install.sh loads config.env from this directory if present.

# dnscrypt-proxy release version
DNSCRYPT_PROXY_VERSION=2.1.18

# Local DoH stub listen address (avoid 53 to not fight systemd-resolved)
DOH_LISTEN_ADDR=127.0.0.1
DOH_LISTEN_PORT=5353

# Network interface for resolvectl; empty = auto (default-route iface)
DOH_DNS_IFACE=

# Install prefix
INSTALL_PREFIX=/opt/doh-dns

# Set to 1 to systemctl enable --now after install
ENABLE_ON_INSTALL=0

# Hosts used by download.sh --broken-dns (override if GitHub CDN IPs change)
# Leave empty to require CLI args.
GITHUB_HOST_IP=
OBJECTS_HOST_IP=
RELEASE_ASSETS_HOST_IP=
