[Unit]
Description=DoH local DNS (dnscrypt-proxy) for networks blocking port 53
Documentation=file:///opt/doh-dns/README.md
Documentation=https://github.com/DNSCrypt/dnscrypt-proxy
After=network-online.target systemd-resolved.service
Wants=network-online.target
Before=nss-lookup.target

[Service]
Type=simple
EnvironmentFile=-/opt/doh-dns/config.env
ExecStart=/opt/doh-dns/dnscrypt-proxy -config /opt/doh-dns/dnscrypt-proxy.toml
ExecStartPost=/opt/doh-dns/doh-dns-apply on
ExecStopPost=/opt/doh-dns/doh-dns-apply off
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/doh-dns /opt/doh-dns
WorkingDirectory=/opt/doh-dns

[Install]
WantedBy=multi-user.target
