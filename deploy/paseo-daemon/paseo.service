[Unit]
Description=Paseo daemon (user service)
After=default.target

[Service]
Type=simple
# Reference file — do not hand-edit ExecStart here.
# Run ./deploy/paseo-daemon/install.sh instead: it resolves the real absolute
# path of paseo (under nvm it looks like
# ~/.nvm/versions/node/<ver>/bin/...; shims are often invisible to systemd),
# generates ~/.config/systemd/user/paseo.service, and runs enable --now.
# The login shell's PATH and other variables go to
# ~/.config/environment.d/60-paseo.conf, not into this unit: Environment=PATH
# in a unit replaces the whole variable and $PATH is not expanded there.
# The line below is only an example of what the generated unit looks like;
# %h = the user's home directory.
ExecStart=%h/.nvm/versions/node/v24.14.0/bin/paseo daemon run --home %h/.paseo
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
