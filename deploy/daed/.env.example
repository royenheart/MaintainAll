# Optional runtime selection. Copy to .env only when selecting a deployment.
# The default remains the image currently in production.
DAED_IMAGE=ghcr.io/daeuniverse/daed@sha256:13e8cb126fbb6764234d1be682e708d735fa15417f8f3141e415064e660cde51

# After a private package is published, use its immutable manifest digest:
# DAED_IMAGE=ghcr.io/royenheart/daed@sha256:<published-manifest-digest>
# For a locally built candidate, use its unique, reviewed DAED_BUILD_IMAGE tag.
# Store registry credentials with docker login, never in this file.
