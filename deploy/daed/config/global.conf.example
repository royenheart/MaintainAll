# 通用全局配置模板（进入版本管理）。
# daed-init.py 首次初始化时会用它生成 config/global.conf（本地文件，不入版本库）。
# 生成规则：lan_interface 自动替换为检测到的物理网卡 + docker0 + 所有 UP 的 br-*；
# 如需固定其它网卡，生成后直接编辑 config/global.conf。
tproxy_port: "12345"
tproxy_port_protect: "true"
log_level: "info"
# Include one IPv4 and one IPv6 address. A list with only IPv4 leaves tcp6,
# tcp6(DNS) and udp6(DNS) at NOT ALIVE, and dae does not retry those families.
tcp_check_url: "http://cp.cloudflare.com,1.1.1.1,2606:4700:4700::1111"
tcp_check_http_method: "HEAD"
udp_check_dns: "dns.google:53,8.8.8.8,2001:4860:4860::8888"
check_interval: "60s"
check_tolerance: "500ms"
lan_interface: "<YOUR_LAN_INTERFACE>"
wan_interface: "auto"
# domain++: re-route by sniffed SNI so domain() rules still apply to LAN clients
# that resolve DNS themselves (their DNS does not traverse dae). Costs extra CPU.
dial_mode: "domain++"
allow_insecure: "false"
auto_config_kernel_parameter: "true"
sniffing_timeout: "100ms"
tls_implementation: "tls"
utls_imitate: "chrome_auto"
enable_local_tcp_fast_redirect: "true"
# Direct mode. DoH mode rewrites this value in wing.db to the foreign
# resolver's :53 (dae accepts only ip:port here). The template file stays
# on the direct-mode value.
fallback_resolver: "223.5.5.5:53"
bandwidth_max_tx: "200 mbps"
bandwidth_max_rx: "1 gbps"
