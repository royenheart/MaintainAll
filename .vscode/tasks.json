{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start qemu gdb server",
            "type": "shell",
            "command": "qemu-multiarch",
            "args": [
                "-g",
                "3345",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": "^(.*)$",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^QEMU.*CPU model",
                        "endsPattern": "^.*Listening on port.*"
                    }
                }
            ]
        }
    ]
}