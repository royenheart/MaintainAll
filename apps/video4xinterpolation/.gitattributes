# Keep LF in the repository (Linux / WSL / cross-platform)
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Binary
*.onnx binary
*.pkl binary
*.npz binary
*.png binary
*.jpg binary
