{
  "name": "@royenheart/home",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && eslint src tests .storybook && prettier --check src tests .storybook deploy scripts *.mjs *.ts *.json",
    "format": "prettier --write src tests .storybook deploy scripts *.mjs *.ts *.json",
    "build": "node scripts/scene-audio.mjs check && astro check && astro build",
    "preview": "astro preview --ignore-lock --host 127.0.0.1 --port 4321",
    "test": "vitest run --project unit",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "node scripts/scene-audio.mjs check && storybook build -o storybook-static",
    "test-storybook": "vitest run --project storybook",
    "e2e": "playwright test",
    "perf": "playwright test tests/perf --project chromium",
    "bundle-report": "node scripts/bundle-report.mjs",
    "test-deploy": "node deploy/smoke.mjs",
    "optics:generate": "node --experimental-strip-types scripts/generate-optics.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "motion": "13.4.4",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.39.1",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.0",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.13",
    "vitest": "4.1.11"
  }
}
