---
import { OrbitPreview } from '../components/OrbitPreview';
import { site } from '../lib/content/load';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="description"
      content="RoyenHeart's personal space. Blue cube clouds, a golden event horizon, and a little music for the journey."
    />
    <meta name="theme-color" content="#030a12" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{site.title}</title>
  </head>
  <body>
    <OrbitPreview client:only="react" />
    <noscript>This interactive experience requires JavaScript.</noscript>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    min-height: 100%;
    background: #030a12;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
