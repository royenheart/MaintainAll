{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "cases",
    "arms",
    "schedule",
    "limits",
    "model",
    "effort",
    "runtime",
    "fingerprint",
    "mode",
    "suite_id",
    "suite_sha256",
    "case_hashes"
  ],
  "properties": {
    "commit_provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_sha",
            "previous_sha",
            "trusted_sha",
            "source_run_id",
            "source_run_attempt",
            "protocol_id"
          ],
          "properties": {
            "candidate_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "previous_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "trusted_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_run_id": {
              "type": "integer",
              "minimum": 1
            },
            "source_run_attempt": {
              "type": "integer",
              "minimum": 1
            },
            "protocol_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
            },
            "tracking_key": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "candidate_sha",
            "previous_sha",
            "candidate_committed_epoch",
            "candidate_parents",
            "protocol_id"
          ],
          "properties": {
            "source": {
              "const": "local-manual"
            },
            "candidate_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "previous_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "candidate_committed_epoch": {
              "type": "integer",
              "minimum": 0
            },
            "candidate_parents": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "protocol_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
            },
            "previous_committed_epoch": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "effort": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "explicit_skill_provision",
        "legacy_import"
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "suite_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "case_hashes": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "turns"
        ]
      }
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "skill_hash",
          "skill_snapshot"
        ]
      }
    },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "trial_id",
          "case_id",
          "arm",
          "repeat"
        ],
        "properties": {
          "trial_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "arm": {
            "enum": [
              "none",
              "previous",
              "candidate"
            ]
          },
          "repeat": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "limits": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "explicit_skill_provision"
          }
        }
      },
      "then": {
        "properties": {
          "limits": {
            "type": "object",
            "required": [
              "max_calls",
              "planned_calls",
              "wall_seconds",
              "turn_seconds"
            ],
            "properties": {
              "max_calls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 54
              },
              "planned_calls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 54
              },
              "wall_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10800
              },
              "turn_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600
              }
            }
          }
        }
      }
    }
  ]
}
