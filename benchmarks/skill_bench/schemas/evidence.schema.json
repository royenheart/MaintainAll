{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "trial_id",
    "status",
    "turns"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trial_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "interrupted",
        "unsupported"
      ]
    },
    "turns": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "turn",
          "status",
          "artifacts"
        ],
        "properties": {
          "turn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "interrupted",
              "unsupported"
            ]
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "snapshot",
                "sha256",
                "size"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "snapshot": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8388608
                }
              }
            }
          },
          "usage": {
            "type": "object"
          }
        }
      }
    },
    "quality_status": {
      "enum": [
        "unassessed",
        "independently_reviewed"
      ]
    }
  }
}
