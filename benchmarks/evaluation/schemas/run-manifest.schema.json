{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunManifest",
  "type": "object",
  "required": [
    "run_id",
    "suite",
    "case",
    "arm",
    "workflow_sha256",
    "prompt_sha256",
    "agent_runtime",
    "model",
    "provider",
    "source"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "case": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "type": "string",
      "minLength": 1
    },
    "workflow_sha256": {
      "type": "string",
      "minLength": 1
    },
    "prompt_sha256": {
      "type": "string",
      "minLength": 1
    },
    "agent_runtime": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
