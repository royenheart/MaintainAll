{
  "schema_version": 1,
  "updated_at": "2026-09-24",
  "policy": {
    "max_age_days": 45,
    "unknown_tier": "U",
    "provisional_requires_supplements": true,
    "promotion": {
      "independent_organizations": 2,
      "local_cases_per_task": 30,
      "local_repetitions": 3,
      "confidence_level": 0.95,
      "critical_failures_allowed": 0,
      "requires_same_configuration": true
    },
    "aggregation": {
      "method": "per-task evidence review; no arithmetic across incompatible benchmark scales",
      "order": [
        "local reproducible task outcomes",
        "independent task-specific benchmarks",
        "human preference and reproducible community reports",
        "vendor claims"
      ],
      "community_can_promote_alone": false,
      "size_can_promote_alone": false
    },
    "invariants": [
      "No tier changes permissions, source requirements, or verification standards.",
      "Never infer model identity, hidden effort, parameter counts or benchmark scores.",
      "No provider calls, model switching, deployment or telemetry is performed by this policy helper."
    ]
  },
  "tasks": {
    "coding": {
      "description": "Implement behavior and tests",
      "sources": [
        "livecodebench",
        "swebench"
      ]
    },
    "debugging": {
      "description": "Diagnose and repair failures",
      "sources": [
        "swebench",
        "terminalbench"
      ]
    },
    "design": {
      "description": "Architecture, decomposition and planning",
      "sources": [
        "livebench",
        "aa-method"
      ]
    },
    "review": {
      "description": "Find defects and verify claims",
      "sources": [
        "swebench",
        "livebench"
      ]
    },
    "tool_use": {
      "description": "Correct multi-step tools, shell and plugin operations",
      "sources": [
        "bfcl",
        "terminalbench"
      ]
    },
    "writing": {
      "description": "Clear requirements, documentation and reusable instructions",
      "sources": [
        "livebench",
        "arena"
      ]
    }
  },
  "tiers": {
    "U": {
      "rank": 0,
      "profile": "scaffolded",
      "description": "Unassessed or unavailable configuration; no capability claim."
    },
    "T1": {
      "rank": 1,
      "profile": "scaffolded",
      "description": "Bounded tasks with explicit contracts and intermediate checks."
    },
    "T2": {
      "rank": 2,
      "profile": "standard",
      "description": "Multi-step implementation/integration with explicit acceptance checks."
    },
    "T3": {
      "rank": 3,
      "profile": "analytical",
      "description": "Complex diagnosis/design/review with competing hypotheses and independent evidence."
    }
  },
  "profiles": {
    "scaffolded": {
      "instructions": [
        "State one bounded objective, inputs and expected output before each unit of work.",
        "Use one small change/experiment at a time and inspect the result before continuing.",
        "Prefer deterministic scripts/schema checks and concrete examples; request missing critical context."
      ],
      "supplements": [
        "contract-check",
        "evidence-ledger"
      ],
      "additional_skills": [
        "writing-plans",
        "verification-before-completion"
      ]
    },
    "standard": {
      "instructions": [
        "Work from explicit acceptance criteria; plan at component boundaries.",
        "Batch independent reads, keep dependent writes ordered, and verify integration."
      ],
      "supplements": [
        "evidence-ledger"
      ],
      "additional_skills": [
        "verification-before-completion"
      ]
    },
    "analytical": {
      "instructions": [
        "Compare plausible explanations and state what evidence distinguishes them.",
        "Use concise constraints rather than redundant step-by-step prompting; review risky assumptions independently."
      ],
      "supplements": [
        "evidence-ledger"
      ],
      "additional_skills": [
        "verification-before-completion"
      ]
    }
  },
  "supplements": {
    "contract-check": [
      "Record expected inputs/outputs, boundary cases and the check that will establish completion.",
      "After each bounded step, compare observed output with that contract."
    ],
    "evidence-ledger": [
      "Separate observed facts, hypotheses, unavailable data and completed checks.",
      "Record tool failures honestly; do not replace missing evidence with confidence."
    ],
    "risk-review": [
      "For destructive, security-sensitive, migration or broad cross-system work, record rollback and inspect affected contracts.",
      "Obtain independent review when available; a stronger model does not remove authorization requirements."
    ]
  },
