#%Module -*- tcl -*-
set NAME "cuda"
set VERSION "12.2"
set SPATH /usr/local/$NAME-$VERSION
proc ModulesHelp { } {
        global NAME
        global VERSION
        puts stderr "$NAME $VERSION"
}

# module whatis
module-whatis "$NAME $VERSION"

# 直接载入需要的包
# module load ucx/1.15.0-mlnxofed-cuda12.3-gdrcopy-full
# module load singularity/3.9.8

# 必须被前置载入的包，当没检测到载入，退出
# prereq cuda/12.3

# 指定无法同时载入的软件包
conflict $NAME

# 设置环境变量
prepend-path     PKG_CONFIG_PATH            $SPATH/lib64/pkgconfig
prepend-path     CMAKE_PREFIX_PATH          $SPATH/lib64/cmake
prepend-path     PATH                       $SPATH/bin
prepend-path     LD_LIBRARY_PATH            $SPATH/lib64
